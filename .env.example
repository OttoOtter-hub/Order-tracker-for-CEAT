DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ceat
DB_PASSWORD=ceat
DB_DATABASE=ceat_order_track
# Set to "true" for managed Postgres that requires SSL (e.g. Neon)
DB_SSL=false
PORT=3000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Comma-separated allowed origins for the frontend (Vite dev server default)
CORS_ORIGIN=http://localhost:5173

# Local disk path for uploaded documents (PDFs/scans) — relative paths are
# resolved from the process cwd. Point this at a persistent volume in prod.
UPLOAD_DIR=./uploads

# SMTP for email notifications (Phase 13). Leave EMAIL_HOST/USER/PASSWORD
# blank to run without email — NotificationsService logs "email not sent:
# SMTP not configured" and continues instead of failing the triggering action.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@ceat-order-track.local

# Daily check for containers newly entering arrivalStatus "expected" (cron
# syntax, minute hour day month weekday). Defaults to 08:00 if unset.
NOTIFICATION_CHECK_CRON=0 8 * * *
